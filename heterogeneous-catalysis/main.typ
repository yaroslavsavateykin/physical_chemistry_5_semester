#section(1, "Условия проведения эксперимента")

$
  T = 26 degree "C", quad C("H"_2 "O"_2) = 0.16 space "М", quad
  V("H"_2 "O"_2) = 20 space "мл", quad p = 1.016 space "бар"
$

#section(2, "Экспериментальные данные")

#{
  let d1 = csv("data/1.csv")
