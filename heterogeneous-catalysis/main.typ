  let r2 = d2.slice(1)
  let r3 = d3.slice(1)
  let n = calc.max(r1.len(), r2.len(), r3.len())
  let rows = range(n).map(i => (
    if i < r1.len() { r1.at(i).at(0) } else { "" },
    if i < r1.len() { r1.at(i).at(1) } else { "" },
    if i < r2.len() { r2.at(i).at(0) } else { "" },
    if i < r2.len() { r2.at(i).at(1) } else { "" },
    if i < r3.len() { r3.at(i).at(0) } else { "" },
    if i < r3.len() { r3.at(i).at(1) } else { "" },
  ))
  datatable(
    ("Время, с", "V, мл", "Время, с", "V, мл", "Время, с", "V, мл"),
    rows,
    caption: [Экспериментальные данные],
  )
}

